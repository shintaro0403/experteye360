{
  "name": "experteye360",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix participant-web && npm install --prefix admin-web",
    "dev": "npm run dev:participant",
    "dev:participant": "npm run dev --prefix participant-web",
    "dev:admin": "npm run dev --prefix admin-web",
    "build:all": "npm run build --prefix participant-web && npm run build --prefix admin-web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real-sheet": "node scripts/run-real-sheet-e2e.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^17.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.7.3",
    "vitest": "^3.0.5"
  }
}
