# GitHub Pages / 本番ビルド用（.env.production にコピー。Git には含めない）
# 手元で Pages 相当を試す: ルートで npm run build:pages（環境変数を export してから）

VITE_STORAGE_BACKEND=sheet
VITE_SHEET_API_BASE=https://script.google.com/macros/s/XXXXXXXX/exec
VITE_CLIENT_ID=lipronext-demo

# build:pages / GitHub Actions では VITE_PAGES_REPO=experteye360 を付与（base パス用）
